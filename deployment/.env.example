# Host directories containing complete Hugging Face model exports.
VLXGO_MODEL_DIR=../resources/vlxgo
DINOV3_MODEL_DIR=../resources/dinov3-vits16-pretrain-lvd1689m
SIGLIP_MODEL_DIR=../resources/siglip-so400m-patch14-384

# Select one host GPU; the allocated GPU is cuda:0 inside the container.
GPU_ID=0
PORT=8233
SHM_SIZE=1gb
VLXGO_ATTN_IMPL=sdpa
VLXGO_ATTN_STRICT=0

# Override only with an image that includes compatible PyTorch and torchvision.
BASE_IMAGE=nvcr.io/nvidia/pytorch:25.06-py3
